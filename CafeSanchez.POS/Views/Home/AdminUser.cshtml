@{

}
<h1>Cafe Sanchéz</h1>
<hr />

<div class="row">
    <div class="col-4">
        @if (ViewBag.CreateNew)
        {
            <form method="post" asp-action="CreateUser">
                <h2 class="mb-3">Create User</h2>
                <div class="form-floating mb-3">
                    <input id="fullname" name="fullname" class="form-control" type="text" placeholder="Fullname" />
                    <label for="email">Fullname</label>
                </div>
                <div class="form-floating mb-3">
                    <input id="email" name="email" class="form-control" type="text" placeholder="Email" />
                    <label for="email">Email</label>
                </div>
                <div class="form-floating mb-3">
                    <input id="username" name="username" class="form-control" type="text" placeholder="Username" />
                    <label for="username">Username</label>
                </div>
                <div class="form-floating mb-3">
                    <input id="password" name="password" class="form-control" type="password" placeholder="Password" />
                    <label for="password">Password</label>
                </div>
                <button class="w-100 btn btn-primary" type="submit">Submit</button>
            </form>
        }
        else
        {
            <form method="post" asp-action="ChangePassword">
                <h2 class="mb-3">Change Password</h2>
                <div class="form-floating mb-3">
                    <input id="oldpassword" name="oldpassword" class="form-control" type="password" placeholder="Password" />
                    <label for="oldpassword">Old Password</label>
                </div>
                <div class="form-floating mb-3">
                    <input id="newpassword" name="newpassword" class="form-control" type="password" placeholder="Password" />
                    <label for="newpassword">New Password</label>
                </div>
                <button class="w-100 btn btn-primary" type="submit">Submit</button>
            </form>
        }
    </div>
    <div class="col"></div>
</div>